<FilesMatch "(\.bak|\.orig|\.old|\.sql|~)">
Require all denied
</FilesMatch>
<FilesMatch "^(config|install|icons)\.php$">
Require all denied
</FilesMatch>
RewriteEngine On
RewriteBase /garmin/
RewriteCond %{THE_REQUEST} \s/garmin/index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^api$ api.php [L,QSA]
RewriteRule ^gpx/([0-9]+)$ api.php?acao=gpx&id=$1 [L,QSA]
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
<FilesMatch "sw\.js$">
Header set Cache-Control "no-cache"
Header set Service-Worker-Allowed "/garmin/"
</FilesMatch>
</IfModule>
