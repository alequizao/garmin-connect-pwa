<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application id="5f25b5443f344c08986a892174639067" type="watch-app" name="@Strings.AppName" entry="GasolinaApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.1.0">
    <iq:products>
      <iq:product id="fr55"/>
      <iq:product id="fr165"/>
      <iq:product id="fr165m"/>
    </iq:products>
    <iq:permissions>
      <!-- Positioning: GPS do relógio; Communications: consulta de preços pelo celular pareado;
           Sensor: bússola, se o relógio tiver (FR55/FR165 não têm; aí a seta usa o rumo do GPS) -->
      <iq:uses-permission id="Positioning"/>
      <iq:uses-permission id="Communications"/>
      <iq:uses-permission id="Sensor"/>
    </iq:permissions>
    <iq:languages><iq:language>por</iq:language><iq:language>eng</iq:language></iq:languages>
    <iq:barrels/>
  </iq:application>
</iq:manifest>
